{
  "name": "legion",
  "productName": "LEGION",
  "version": "1.0.0",
  "description": "LEGION — a personal AI intelligence living inside your computer.",
  "main": "src/main/main.js",
  "author": "LEGION",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "ai.legion.desktop",
    "productName": "LEGION",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
