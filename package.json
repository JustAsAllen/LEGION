{
  "name": "legion",
  "productName": "LEGION",
  "version": "1.0.0",
  "description": "LEGION — a personal AI intelligence living inside your computer.",
  "main": "src/main/main.js",
  "author": "LEGION",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "selftest": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scope-selftest.js",
    "check:static": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/static-check.js .",
    "check:data": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-data.js .",
    "check:ipc": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ipc.js .",
    "check:firstrun": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-firstrun.js .",
    "check:security": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-security.js",
    "check:package": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-package.js",
    "check:voice": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-voice.js .",
    "check:voicepack": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-voicepack.js",
    "voicepack:sample": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-voicepack-sample.js",
    "check:shell": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-shell.js .",
    "check:render": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-render.js .",
    "check": "npm run selftest && npm run check:static && npm run check:ipc && npm run check:security && npm run check:data && npm run check:voice && npm run check:voicepack && npm run check:firstrun && npm run check:shell && npm run check:render",
    "check:fast": "npm run selftest && npm run check:static && npm run check:ipc && npm run check:security",
    "check:launch": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-launch.js",
    "bench": "node --experimental-vm-modules --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench.js",
    "launch": "electron ."
  },
  "dependencies": {
    "msedge-tts": "^2.0.8",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "ai.legion.desktop",
    "productName": "LEGION",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "voicepack/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "voicepack",
        "to": "voicepack"
      },
      {
        "from": "assets/piper",
        "to": "piper",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
