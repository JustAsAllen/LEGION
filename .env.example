# LEGION environment variables
#
# Every one of these is optional. LEGION runs with no environment set at all:
# keys can instead be entered in the app, which stores them in
# userData/secrets.json with 0600 permissions. This file documents the
# variables the app reads -- it is not loaded automatically, and it holds no
# real values.
#
# API keys are read in the main process only. They are never sent to the
# renderer, and the UI can only report whether a key is present, never its
# value.

# Gemini. Powers the default provider.
GEMINI_API_KEY=
# Optional; the provider falls back to gemini-3.8-flash when unset.
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic (Claude). Selectable in Settings > AI.
ANTHROPIC_API_KEY=

# OpenAI. Selectable in Settings > AI.
OPENAI_API_KEY=

# Not configurable, listed so it is not mistaken for an option: LEGION reads
# APPDATA (Electron sets it for userData), and that is the only other variable
# the app touches.
