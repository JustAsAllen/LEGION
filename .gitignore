# dependencies
node_modules/

# build output and test captures
dist/
out/
release/
artifacts/
*.log

# local runtime state — settings.json and secrets.json are written here by
# Electron under userData, but keep these patterns so a local run that puts
# them beside the source can never be committed
secrets.json
settings.json
*.secret
.env
.env.*
# The pattern above is correct for real secrets, but it also swallows the
# documented template. Keep the example, never a real .env.
!.env.example

# editor and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
